{
  "expo": {
    "name": "Universal HRA",
    "slug": "universal-hra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
  
    "ios": {
      "supportsTablet": true,
        "bundleIdentifier": "com.universalhra.cleaningapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to autofill your address.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We use your location to improve service experience."
      }
    },
    "android": {
       "package": "com.universalhra.cleaningapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
           "bundler": "metro"
    }
  }
}
